def normalize_business(b: str) -> str:
    b = (b or "").strip().lower()
    if b in KB:
        return b
    if b in SYNONYMS:
        return SYNONYMS[b]
    # try keyword contains
    for k, v in SYNONYMS.items():
        if k in b:
            return v
    return b  # unknown, will use generic templates

def compile_report_text(business: str, recs: Dict[str, Dict]):
    buf = io.StringIO()
    buf.write(f"# Recommendations for '{business.title()}' in Bangalore & Hyderabad\n\n")
    for city, places in recs.items():
        buf.write(f"## {city}\n")
        for locality, info in places.items():
            buf.write(f"### {locality}\n")
            buf.write(f"- **Advantages:** " + "; ".join(info.get("advantages", [])) + "\n")
            buf.write(f"- **Risks:** " + "; ".join(info.get("risks", [])) + "\n")
            buf.write(f"- **Budget:** {info.get('budget','N/A')}\n")
            buf.write(f"- **Legal/Permits:** " + ", ".join(info.get("legal", [])) + "\n")
            buf.write(f"- **Type of Space:** {info.get('space_type','')}\n")
            buf.write(f"- **Target Customers:** {info.get('target_customers','')}\n")
            buf.write(f"- **Infrastructure:** " + ", ".join(info.get("infra", [])) + "\n")
            buf.write(f"- **Marketing:** " + "; ".join(info.get("marketing", [])) + "\n")
            buf.write(f"- **Success Tip:** {info.get('success_tip','')}\n\n")
    return buf.getvalue()

